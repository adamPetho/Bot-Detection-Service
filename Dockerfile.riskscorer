# syntax=docker/dockerfile:1
# ─── Build stage ─────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy solution and project files first for layer caching
COPY Bot-Detection-Service/Bot-Detection-Service.csproj Bot-Detection-Service/

RUN --mount=type=cache,id=nuget-${TARGETARCH},target=/root/.nuget/packages \
	dotnet restore Bot-Detection-Service/Bot-Detection-Service.csproj

# Copy the rest of the service source
COPY Bot-Detection-Service/ Bot-Detection-Service/

# Publish the Release build
RUN dotnet publish Bot-Detection-Service/Bot-Detection-Service.csproj -c Release -o /app/publish --no-restore

# ─── Runtime stage ───────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

# Run as the non-root user baked into the .NET base image, not root.
USER $APP_UID

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Bot-Detection-Service.dll"]